---
import { getCollection, render } from 'astro:content';
import HeroDetect from '../components/HeroDetect.astro';
import NewsCard from '../components/NewsCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import VideoThumb from '../components/VideoThumb.astro';
import { LAB } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { attachment } from '../lib/attachments';
import { getPage, getResearchAreas, getSortedPublications } from '../lib/content';

// 내용 수정: src/content/home.md (소개 문구 + 아래쪽 ## 절들), src/content/research.md
const home = await getPage('home');
const { Content: Lead } = await render(home);
// home.md 의 ## 절: 쓴 순서대로 전부 표시 (사진만 있으면 로고 목록, 아니면 글 상자)
const sections = await Promise.all(
	(await getCollection('home'))
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (s) => ({ ...s.data, Content: (await render(s)).Content })),
);
const areas = await getResearchAreas();

const news = (await getCollection('news'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const pubs = await getSortedPublications();
// 첫 화면: projects.md에 "탐지:" 줄을 적은 과제의 대표 사진 (최신 순). 하나도 없으면 가장 최근 과제 사진 하나
const withCover = (await getCollection('projects'))
	.sort((a, b) => b.data.no - a.data.no)
	.flatMap((p) => {
		const image = attachment(p.data.image);
		return image
			? [{ no: p.data.no, title: p.data.title, href: `/projects#${p.id}`, image, alt: p.data.imageAlt ?? p.data.title, detections: p.data.detections }]
			: [];
	});
const detected = withCover.filter((s) => s.detections.length);
const slides = detected.length ? detected : withCover.slice(0, 1);
const highlights = areas.flatMap((a) => a.data.topics.map((t) => ({ ...t, pillar: a.data.titleEn })));
---

<BaseLayout description={home.data.description}>
	<section slot="hero" class="hero">
		<HeroDetect slides={slides}>
			<h1>{LAB.fullName}</h1>
			<div class="lead">
				<Lead />
			</div>
			<a class="btn primary" href="/research">연구 분야 보기</a>
		</HeroDetect>
	</section>

	<section class="areas">
		<div class="section-head">
			<h2>연구 분야</h2>
			<a href="/research">자세히</a>
		</div>
		<ul class="pillars">
			{
				areas.map((a) => (
					<li>
						<a class="card pillar" href={`/research#${a.id}`}>
							<p class="en">{a.data.titleEn}</p>
							<h3>{a.data.title}</h3>
							<p class="muted">{a.data.summary}</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-head">
			<h2>연구 하이라이트</h2>
			<a href={LAB.youtube} target="_blank" rel="noopener">유튜브 채널</a>
		</div>
		<ul class="highlights">
			{
				highlights.map((h) => (
					<li>
						{h.video && <VideoThumb id={h.video} title={h.title} />}
						<p class="en">{h.pillar}</p>
						<h3>{h.title}</h3>
						<p class="muted">{h.summary}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-head">
			<h2>NEWS</h2>
			<a href="/news">전체 보기</a>
		</div>
		<ul class="news">
			{
				news.map((post) => (
					<li>
						<NewsCard post={post} />
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-head">
			<h2>최근 논문</h2>
			<a href="/publications">전체 보기</a>
		</div>
		<ul class="pubs">
			{pubs.slice(0, 3).map((pub) => <PublicationItem pub={pub} />)}
		</ul>
	</section>

	{
		sections.map(({ title, kind, Content }) => (
			<section class:list={['home-section', kind]}>
				<div class="section-head">
					<h2>{title}</h2>
				</div>
				<div class:list={['body', { 'prose card': kind === 'text' }]}>
					<Content />
				</div>
			</section>
		))
	}
</BaseLayout>

<style>
	.hero {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 56px 1rem 96px; /* main 과 같은 좌우 여백 */
	}
	.hero h1 {
		margin: 0 0 20px;
		font-size: clamp(2.75rem, 6vw, 5.25rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}
	.lead {
		max-width: 30em;
		margin-bottom: 28px;
		color: var(--text-muted);
	}
	.lead :global(p) {
		margin: 0;
	}
	.lead :global(strong) {
		color: var(--text);
	}
	.btn {
		display: inline-block;
		padding: 12px 20px;
		background: var(--ink);
		color: var(--paper);
		font-weight: 500;
		text-decoration: none;
	}
	.btn:hover {
		background: var(--accent-dark);
		color: #fff;
	}

	section + section {
		margin-top: 4rem;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}
	.section-head a {
		font-size: 0.95rem;
		text-decoration: none;
	}
	.pillars,
	.highlights,
	.news,
	.pubs {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.pillars {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.25rem;
	}
	.pillar {
		display: block;
		height: 100%;
		color: var(--text);
		text-decoration: none;
		transition:
			transform 0.15s,
			border-color 0.15s;
	}
	.pillar:hover {
		transform: translateY(-2px);
		border-color: var(--accent);
		color: var(--text);
	}
	.icon {
		display: block;
		margin-bottom: 0.5rem;
		font-size: 2rem;
	}
	.en {
		margin: 0;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.05em;
	}
	.pillar p:last-child {
		margin: 0;
		font-size: 0.95rem;
	}
	.highlights {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.75rem 1.25rem;
	}
	.highlights .en {
		margin-top: 0.75rem;
	}
	.highlights h3 {
		margin: 0.1rem 0 0.25rem;
		font-size: 1.05rem;
	}
	.highlights p.muted {
		margin: 0;
		font-size: 0.9rem;
	}
	.news {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem;
	}
	/* home.md 의 글 상자 절 */
	.text .body {
		background: var(--accent-soft);
		border-color: transparent;
	}
	.text .body :global(blockquote) {
		margin: 0.75rem 0 0;
		padding: 0;
		border: 0;
		color: var(--text-muted);
		font-size: 0.85rem;
	}
	.text .body :global(blockquote p) {
		margin: 0;
	}
	/* 마지막 줄에 링크 하나만 있으면 버튼 */
	.text .body :global(p:last-child:has(> a:only-child)) {
		margin: 1rem 0 0;
	}
	.text .body :global(p:last-child > a:only-child) {
		display: inline-flex;
		padding: 0.6rem 1.2rem;
		border-radius: 10px;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		text-decoration: none;
	}
	.text .body :global(p:last-child > a:only-child:hover) {
		background: var(--accent-dark);
	}
	/* home.md 의 로고 절 (사진만 있는 절) */
	.logos .body {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 1rem;
	}
	.logos .body :global(p) {
		display: grid;
		place-items: center;
		height: 88px;
		margin: 0;
		padding: 0.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: #fff;
	}
	.logos .body :global(img) {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: 0;
	}
	@media (max-width: 760px) {
		.hero {
			padding: 24px 16px 56px;
		}
	}
</style>
