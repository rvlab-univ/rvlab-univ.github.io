---
import { getCollection, render } from 'astro:content';
import NewsCard from '../components/NewsCard.astro';
import PublicationItem from '../components/PublicationItem.astro';
import VideoThumb from '../components/VideoThumb.astro';
import { LAB } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, getResearchAreas, getSortedPublications } from '../lib/content';

// 내용 수정: src/content/home.md (소개 문구 + 아래쪽 ## 절들), src/content/research.md
const home = await getPage('home');
const { Content: Lead } = await render(home);
// home.md 의 ## 절: 쓴 순서대로 전부 표시 (사진만 있으면 로고 목록, 아니면 글 상자)
const sections = await Promise.all(
	(await getCollection('home'))
		.sort((a, b) => a.data.order - b.data.order)
		.map(async (s) => ({ ...s.data, Content: (await render(s)).Content })),
);
const areas = await getResearchAreas();

const news = (await getCollection('news'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const pubs = await getSortedPublications();
const highlights = areas.flatMap((a) => a.data.topics.map((t) => ({ ...t, pillar: a.data.titleEn })));
---

<BaseLayout description={home.data.description}>
	<Fragment slot="head">
		<!-- 등장 애니메이션 전에 hero 내용이 잠깐 보였다 사라지지 않게 숨겨 둔다 (JS가 꺼져 있으면 그대로 보임).
		     아래 GSAP 스크립트가 실행되지 않더라도 3초 뒤에는 보이게 한다 -->
		<script is:inline>
			if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
				document.documentElement.classList.add('hero-pending');
				setTimeout(() => document.documentElement.classList.remove('hero-pending'), 3000);
			}
		</script>
	</Fragment>

	<section slot="hero" class="hero">
		<div class="hero-inner">
			<p class="eyebrow">{LAB.university}</p>
			<h1>{LAB.name}<span>{LAB.fullName}</span></h1>
			<div class="lead">
				<Lead />
			</div>
			<div class="cta">
				<a class="btn primary" href="/research">연구 분야 보기</a>
				<a class="btn" href="/publications">논문 목록</a>
				<a class="btn" href={LAB.youtube} target="_blank" rel="noopener">▶ YouTube</a>
			</div>
		</div>
	</section>

	<section class="areas">
		<div class="section-head">
			<h2>연구 분야</h2>
			<a href="/research">자세히 →</a>
		</div>
		<ul class="pillars">
			{
				areas.map((a) => (
					<li>
						<a class="card pillar" href={`/research#${a.id}`}>
							<span class="icon" aria-hidden="true">
								{a.data.icon}
							</span>
							<p class="en">{a.data.titleEn}</p>
							<h3>{a.data.title}</h3>
							<p class="muted">{a.data.summary}</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-head">
			<h2>연구 하이라이트</h2>
			<a href={LAB.youtube} target="_blank" rel="noopener">유튜브 채널 →</a>
		</div>
		<ul class="highlights">
			{
				highlights.map((h) => (
					<li>
						{h.video && <VideoThumb id={h.video} title={h.title} />}
						<p class="en">{h.pillar}</p>
						<h3>{h.title}</h3>
						<p class="muted">{h.summary}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-head">
			<h2>NEWS</h2>
			<a href="/news">전체 보기 →</a>
		</div>
		<ul class="news">
			{
				news.map((post) => (
					<li>
						<NewsCard post={post} />
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-head">
			<h2>최근 논문</h2>
			<a href="/publications">전체 보기 →</a>
		</div>
		<ul class="pubs">
			{pubs.slice(0, 3).map((pub) => <PublicationItem pub={pub} />)}
		</ul>
	</section>

	{
		sections.map(({ title, kind, Content }) => (
			<section class:list={['home-section', kind]}>
				<div class="section-head">
					<h2>{title}</h2>
				</div>
				<div class:list={['body', { 'prose card': kind === 'text' }]}>
					<Content />
				</div>
			</section>
		))
	}
</BaseLayout>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// 시스템에서 '동작 줄이기'를 켠 사용자에게는 애니메이션 없이 보여준다
	gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
		// 등장: 학교명 → 제목 → 소개 문구 → 버튼 순서로 떠오른다
		gsap.from('.hero-inner > *', { y: 24, autoAlpha: 0, duration: 0.8, stagger: 0.1, ease: 'power3.out' });
		document.documentElement.classList.remove('hero-pending');

		// 스크롤: hero 는 제자리에 멈춘 채 작아지며 뒤로 사라지고, 연구 분야부터 시작하는 본문이 그 위를 덮으며 올라온다.
		// hero 가 한 화면에 다 들어올 때만 고정한다 (아니면 아래쪽 버튼을 볼 수 없게 된다)
		const hero = document.querySelector<HTMLElement>('.hero')!;
		if (hero.offsetTop + hero.offsetHeight > window.innerHeight) return;
		gsap
			.timeline({
				defaults: { ease: 'none' },
				scrollTrigger: {
					trigger: hero,
					start: 0,
					end: () => `+=${hero.offsetHeight}`,
					scrub: true,
					pin: true,
					pinSpacing: false,
				},
			})
			.to('.hero-inner', { scale: 0.9, opacity: 0 })
			.from('.areas', { y: 40 }, 0);
	});
</script>

<style>
	:global(.hero-pending) .hero-inner > * {
		visibility: hidden;
	}
	/* 스크롤하면 본문이 hero 위를 덮으며 올라온다: 본문 배경을 화면 양옆까지 채운다 (가로 스크롤은 생기지 않음) */
	:global(main) {
		position: relative;
		z-index: 1;
		background: var(--bg);
		box-shadow: 0 0 0 100vmax var(--bg);
		clip-path: inset(0 -100vmax);
	}
	.hero {
		padding: 5rem 1rem 4rem;
		background:
			radial-gradient(circle at 85% 10%, var(--accent-soft), transparent 55%),
			linear-gradient(var(--bg-alt), var(--bg));
		border-bottom: 1px solid var(--border);
	}
	.hero-inner {
		max-width: var(--max-width);
		margin: 0 auto;
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-weight: 700;
		letter-spacing: 0.04em;
		font-size: 0.95rem;
	}
	.hero h1 {
		font-size: clamp(2.6rem, 7vw, 4.2rem);
		letter-spacing: -0.03em;
	}
	.hero h1 span {
		display: block;
		color: var(--text-muted);
		font-size: 0.42em;
		font-weight: 500;
		letter-spacing: 0;
	}
	.lead {
		max-width: 36em;
		font-size: 1.15rem;
	}
	.lead :global(p) {
		margin: 0;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.7rem 1.3rem;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--card);
		color: var(--text);
		font-weight: 700;
		text-decoration: none;
	}
	.btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.btn.primary {
		border-color: var(--accent);
		background: var(--accent);
		color: #fff;
	}
	.btn.primary:hover {
		background: var(--accent-dark);
		color: #fff;
	}

	section + section {
		margin-top: 4rem;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}
	.section-head a {
		font-size: 0.95rem;
		text-decoration: none;
	}
	.pillars,
	.highlights,
	.news,
	.pubs {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.pillars {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.25rem;
	}
	.pillar {
		display: block;
		height: 100%;
		color: var(--text);
		text-decoration: none;
		transition:
			transform 0.15s,
			border-color 0.15s;
	}
	.pillar:hover {
		transform: translateY(-2px);
		border-color: var(--accent);
		color: var(--text);
	}
	.icon {
		display: block;
		margin-bottom: 0.5rem;
		font-size: 2rem;
	}
	.en {
		margin: 0;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.pillar p:last-child {
		margin: 0;
		font-size: 0.95rem;
	}
	.highlights {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.75rem 1.25rem;
	}
	.highlights .en {
		margin-top: 0.75rem;
	}
	.highlights h3 {
		margin: 0.1rem 0 0.25rem;
		font-size: 1.05rem;
	}
	.highlights p.muted {
		margin: 0;
		font-size: 0.9rem;
	}
	.news {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem;
	}
	/* home.md 의 글 상자 절 */
	.text .body {
		background: var(--accent-soft);
		border-color: transparent;
	}
	.text .body :global(blockquote) {
		margin: 0.75rem 0 0;
		padding: 0;
		border: 0;
		color: var(--text-muted);
		font-size: 0.85rem;
	}
	.text .body :global(blockquote p) {
		margin: 0;
	}
	/* 마지막 줄에 링크 하나만 있으면 버튼 */
	.text .body :global(p:last-child:has(> a:only-child)) {
		margin: 1rem 0 0;
	}
	.text .body :global(p:last-child > a:only-child) {
		display: inline-flex;
		padding: 0.6rem 1.2rem;
		border-radius: 10px;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		text-decoration: none;
	}
	.text .body :global(p:last-child > a:only-child:hover) {
		background: var(--accent-dark);
	}
	/* home.md 의 로고 절 (사진만 있는 절) */
	.logos .body {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 1rem;
	}
	.logos .body :global(p) {
		display: grid;
		place-items: center;
		height: 88px;
		margin: 0;
		padding: 0.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: #fff;
	}
	.logos .body :global(img) {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: 0;
	}
	@media (max-width: 720px) {
		.hero {
			padding: 3rem 1rem 2.5rem;
		}
	}
</style>
