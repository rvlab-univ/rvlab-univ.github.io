---
import type { GetStaticPaths } from 'astro';
import PageHeader from '../../components/PageHeader.astro';
import PublicationList from '../../components/PublicationList.astro';
import { PUBLICATIONS_PAGE_SIZE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPage, getSortedPublications } from '../../lib/content';

// /publications, /publications/2 ... 을 생성
export const getStaticPaths = (async ({ paginate }) => {
	const pubs = await getSortedPublications();
	const counts = Object.fromEntries(
		Object.entries(Object.groupBy(pubs, (p) => p.data.category)).map(([k, v]) => [k, v!.length]),
	);
	return paginate(pubs, { pageSize: PUBLICATIONS_PAGE_SIZE, props: { counts } });
}) satisfies GetStaticPaths;

const { page, counts } = Astro.props;
// 내용 수정: src/content/publications.md
const info = await getPage('publications');
---

<BaseLayout title={info.data.title} description={info.data.description}>
	<PageHeader page={info} eyebrow="Publications" />
	<PublicationList page={page} baseUrl="/publications" counts={counts} />
</BaseLayout>
