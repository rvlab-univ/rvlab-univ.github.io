---
import type { GetStaticPaths } from 'astro';
import PublicationList from '../../../components/PublicationList.astro';
import { PUBLICATION_CATEGORIES, PUBLICATIONS_PAGE_SIZE } from '../../../consts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getSortedPublications } from '../../../lib/publications';

// /publications/intl-journal, /publications/intl-journal/2 ... 을 분류별로 생성
export const getStaticPaths = (async ({ paginate }) => {
	const pubs = await getSortedPublications();
	const counts = Object.fromEntries(
		Object.entries(Object.groupBy(pubs, (p) => p.data.category)).map(([k, v]) => [k, v!.length]),
	);
	return PUBLICATION_CATEGORIES.flatMap((category) =>
		paginate(
			pubs.filter((p) => p.data.category === category.key),
			{
				params: { category: category.key },
				pageSize: PUBLICATIONS_PAGE_SIZE,
				props: { category, counts },
			},
		),
	);
}) satisfies GetStaticPaths;

const { page, category, counts } = Astro.props;
---

<BaseLayout title={`${category.label} 논문`} description={`RV LAB ${category.label} 논문 목록`}>
	<header class="page-header">
		<p class="eyebrow">Publications · {category.en}</p>
		<h1>{category.label}</h1>
		<p>
			<strong>굵은 이름</strong>은 RV LAB 구성원입니다. (*: equal contribution, †: corresponding author)
		</p>
	</header>
	<PublicationList
		page={page}
		baseUrl={`/publications/${category.key}`}
		category={category.key}
		counts={counts}
	/>
</BaseLayout>
