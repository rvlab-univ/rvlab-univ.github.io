---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import NewsCard from '../../components/NewsCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import Pagination from '../../components/Pagination.astro';
import { NEWS_PAGE_SIZE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPage } from '../../lib/content';

// /news, /news/2, /news/3 ... 을 생성
export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection('news')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: NEWS_PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
// 내용 수정: src/content/news/_index.md, src/content/news/*.md
const info = await getPage('news');
---

<BaseLayout title={info.data.title} description={info.data.description}>
	<PageHeader page={info} eyebrow="News" />

	<ul class="grid">
		{
			page.data.map((post) => (
				<li>
					<NewsCard post={post} />
				</li>
			))
		}
	</ul>

	<Pagination page={page} baseUrl="/news" />
</BaseLayout>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
