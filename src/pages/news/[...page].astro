---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import NewsCard from '../../components/NewsCard.astro';
import Pagination from '../../components/Pagination.astro';
import { NEWS_PAGE_SIZE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';

// /news, /news/2, /news/3 ... 을 생성
export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection('news')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: NEWS_PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout title="소식" description="RV LAB의 공지, 수상, 논문, 세미나 소식">
	<header class="page-header">
		<p class="eyebrow">News</p>
		<h1>연구실 소식</h1>
		<p>공지사항, 수상, 논문 게재, 세미나 소식을 전합니다.</p>
	</header>

	<ul class="grid">
		{
			page.data.map((post) => (
				<li>
					<NewsCard post={post} />
				</li>
			))
		}
	</ul>

	<Pagination page={page} baseUrl="/news" />
</BaseLayout>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
