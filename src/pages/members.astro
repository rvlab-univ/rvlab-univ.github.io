---
import { getCollection, render } from 'astro:content';
import Avatar from '../components/Avatar.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/content';

// 내용 수정: src/content/members.md
const page = await getPage('members');
const members = (await getCollection('members')).sort((a, b) => a.data.order - b.data.order);

const professors = await Promise.all(
	members
		.filter((m) => m.data.role === 'professor')
		.map(async (m) => ({ ...m, Content: (await render(m)).Content })),
);
// 학생: 문서의 ## 구분 → ### 팀 순서대로 묶는다
const students = members.filter((m) => m.data.role !== 'professor');
const groups = [...Map.groupBy(students, (m) => m.data.group)].map(([title, people]) => ({
	title,
	teams: [...Map.groupBy(people, (m) => m.data.team ?? '')].map(([label, people]) => ({
		label,
		desc: people[0].data.teamDesc,
		people,
	})),
	count: people.length,
}));
---

<BaseLayout title={page.data.title} description={page.data.description}>
	<PageHeader page={page} eyebrow="People" />

	{
		professors.map(({ data, Content }) => (
			<section class="pi card">
				<div class="pi-head">
					<Avatar name={data.name} width={132} />
					<div>
						<p class="role">Principal Investigator</p>
						<h2>
							{data.name} {data.nameEn && <small>{data.nameEn}</small>}
						</h2>
						{data.title && <p class="muted">{data.title}</p>}
						<p class="contact">
							{data.email && <a href={`mailto:${data.email}`}>{data.email}</a>}
							{data.links.map((l) => (
								<>
									{' · '}
									<a href={l.url} target="_blank" rel="noopener">
										{l.label}
									</a>
								</>
							))}
						</p>
						<ul class="interests">
							{data.research.map((i) => (
								<li class="badge">{i}</li>
							))}
						</ul>
					</div>
				</div>
				<div class="prose cv">
					<Content />
				</div>
			</section>
		))
	}

	{
		groups.map((group) => (
			<>
				<h2 class="group-title">
					{group.title} <small class="muted">{group.count}명</small>
				</h2>
				{group.teams.map((team) => (
					<section class="team">
						{team.label && (
							<h3>
								{team.label} {team.desc && <small class="muted">{team.desc}</small>}
							</h3>
						)}
						<ul class="people">
							{team.people.map(({ data }) => (
								<li class="card person">
									<Avatar name={data.name} width={66} />
									<div>
										<p class="name">{data.name}</p>
										<p class="research">{data.research.join(' · ')}</p>
									</div>
								</li>
							))}
						</ul>
					</section>
				))}
			</>
		))
	}
</BaseLayout>

<style>
	.pi + .pi {
		margin-top: 1.5rem;
	}
	.pi-head {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
	}
	.pi h2 small {
		font-size: 1rem;
		font-weight: 400;
		color: var(--text-muted);
	}
	.role {
		margin: 0;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.pi-head p {
		margin: 0;
	}
	.contact {
		margin-top: 0.4rem !important;
		font-size: 0.92rem;
	}
	.interests {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}
	/* CV 본문: h3 단위로 두 열 배치 */
	.cv {
		columns: 2 340px;
		column-gap: 2.5rem;
		margin-top: 1.5rem;
		font-size: 0.92rem;
	}
	.cv :global(h4) {
		margin: 1.5rem 0 0.75rem;
		color: var(--text-muted);
		font-size: 0.95rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.cv :global(h4:first-child) {
		margin-top: 0;
	}
	.cv :global(h4) {
		break-after: avoid;
	}
	.cv :global(ul) {
		break-inside: avoid-column;
	}
	.cv :global(li) {
		line-height: 1.55;
	}
	.group-title {
		margin-top: 3.5rem;
	}
	.group-title small {
		font-size: 1rem;
		font-weight: 400;
	}
	.team {
		margin-top: 1.5rem;
	}
	.team h3 small {
		font-size: 0.85rem;
		font-weight: 400;
	}
	.people {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 0.9rem;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}
	.person {
		display: flex;
		gap: 0.9rem;
		align-items: center;
		padding: 1rem;
	}
	.person p {
		margin: 0;
	}
	.name {
		font-weight: 700;
	}
	.research {
		color: var(--text-muted);
		font-size: 0.85rem;
		line-height: 1.45;
	}
	@media (max-width: 720px) {
		.pi-head {
			flex-direction: column;
		}
	}
</style>
