---
import { render } from 'astro:content';
import PageHeader from '../components/PageHeader.astro';
import VideoThumb from '../components/VideoThumb.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, getResearchAreas, getResearchStatements } from '../lib/content';

// 내용 수정: src/content/research.md
const page = await getPage('research');
const areas = await Promise.all(
	(await getResearchAreas()).map(async (area) => ({ area, Content: (await render(area)).Content })),
);
const statements = await Promise.all(
	(await getResearchStatements()).map(async (s) => ({ s, Content: (await render(s)).Content })),
);
---

<BaseLayout title={page.data.title} description={page.data.description}>
	<PageHeader page={page} eyebrow="Research" />

	{
		areas.map(({ area, Content }) => (
			<section class="pillar" id={area.id}>
				<div class="intro">
					<div>
						<p class="en">
							{area.data.icon} {area.data.titleEn}
						</p>
						<h2>{area.data.title}</h2>
						<div class="prose">
							<Content />
						</div>
						<ul class="keywords">
							{area.data.keywords.map((k) => (
								<li class="badge">{k}</li>
							))}
						</ul>
					</div>
					{area.data.video && <VideoThumb id={area.data.video} title={area.data.titleEn ?? area.data.title} />}
				</div>

				<ul class="topics">
					{area.data.topics.map((topic) => (
						<li class="card topic">
							{topic.video && <VideoThumb id={topic.video} title={topic.title} />}
							<h3>
								{area.data.titleEn} – {topic.title}
							</h3>
							<p>{topic.summary}</p>
							<p class="paper">
								{topic.status && <span class="status">{topic.status}</span>}
								{topic.paper}
							</p>
						</li>
					))}
				</ul>
			</section>
		))
	}

	{
		statements.map(({ s, Content }) => (
			<section class="statement card prose">
				<p class="eyebrow">Research Statement</p>
				<h2>{s.data.title}</h2>
				<Content />
			</section>
		))
	}
</BaseLayout>

<style>
	.pillar + .pillar {
		margin-top: 4.5rem;
	}
	.intro {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 2rem;
		align-items: center;
		margin-bottom: 2rem;
	}
	.intro .prose {
		margin-bottom: 1rem;
	}
	.en {
		margin: 0;
		color: var(--accent);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.keywords {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.topics {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.topic {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1rem;
	}
	.topic h3 {
		margin: 0.4rem 0 0;
		font-size: 1.05rem;
	}
	.topic p {
		margin: 0;
		font-size: 0.93rem;
	}
	.paper {
		margin-top: auto !important;
		padding-top: 0.6rem;
		border-top: 1px dashed var(--border);
		color: var(--text-muted);
		font-size: 0.8rem !important;
		line-height: 1.5;
	}
	.status {
		margin-right: 0.3rem;
		color: #b7791f;
		font-weight: 700;
	}
	.statement {
		margin-top: 4.5rem;
	}
	.statement :global(img) {
		display: block;
		max-width: min(100%, 720px);
		margin: 1rem auto;
		border-radius: 10px;
	}
	@media (max-width: 760px) {
		.intro {
			grid-template-columns: 1fr;
		}
	}
</style>
