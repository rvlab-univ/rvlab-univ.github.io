---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { attachment } from '../lib/attachments';
import { getPage } from '../lib/content';

// 내용 수정: src/content/projects.md
const page = await getPage('projects');
const projects = await Promise.all(
	(await getCollection('projects'))
		.sort((a, b) => b.data.no - a.data.no)
		.map(async (p) => ({ data: p.data, Content: (await render(p)).Content })),
);
---

<BaseLayout title={page.data.title} description={page.data.description}>
	<PageHeader page={page} eyebrow="Projects" />

	<ol class="projects">
		{
			projects.map(({ data, Content }) => (
				<li class="card project">
					<div class="no" aria-hidden="true">
						{String(data.no).padStart(2, '0')}
					</div>
					<div>
						<h2>
							{data.title}
							{data.lead && <span class="badge">Project Lead</span>}
						</h2>
						<p class="meta">
							<span>{data.funder}</span>
							<span>{data.period}</span>
						</p>
						<div class="prose body">
							<Content />
						</div>
					</div>
					{attachment(data.image) && (
						<Image class="cover" src={attachment(data.image)!} alt={data.imageAlt ?? ''} width={560} />
					)}
				</li>
			))
		}
	</ol>
</BaseLayout>

<style>
	.projects {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.project {
		display: flex;
		gap: 1.5rem;
	}
	.project > div:nth-child(2) {
		flex: 1;
		min-width: 0;
	}
	.cover {
		flex: none;
		align-self: flex-start;
		width: 260px;
		height: auto;
		border-radius: 10px;
	}
	.body :global(img) {
		display: block;
		max-width: min(100%, 560px);
		margin: 1rem 0;
		border-radius: 10px;
	}
	.no {
		flex: none;
		color: var(--accent);
		font-size: 1.8rem;
		font-weight: 700;
		line-height: 1.2;
		opacity: 0.5;
	}
	h2 {
		font-size: 1.15rem;
	}
	h2 .badge {
		margin-left: 0.5rem;
		vertical-align: 0.15em;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		color: var(--text-muted);
		font-size: 0.88rem;
	}
	.meta span + span::before {
		content: '·';
		margin-right: 1rem;
	}
	.body :global(h3) {
		margin: 1rem 0 0.4rem;
		font-size: 0.8rem;
	}
	.body :global(ul) {
		color: var(--text-muted);
		font-size: 0.92rem;
	}
	@media (max-width: 760px) {
		.project {
			flex-direction: column;
			gap: 0.25rem;
		}
		.cover {
			order: -1;
			width: 100%;
			margin-bottom: 0.75rem;
		}
	}
</style>
