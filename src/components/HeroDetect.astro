---
// 첫 화면: 왼쪽 글(slot) + 오른쪽 과제 대표 사진. 사진 위 박스는 projects.md의 "탐지:" 줄(그 과제의 주요 구성요소).
// "탐지:" 줄을 적은 과제만 돌아가며 나온다. 하나도 없으면 가장 최근 과제의 대표 사진만 박스 없이 보여준다.
// 점수 창(폭 0.20)이 0.5~1.0 사이를 오가며, 창 안에 든 점수의 박스만 보여준다 (슬라이딩 윈도우).
// 창은 한쪽 끝까지 움직이고 1.4초 멈춘 뒤, 다음 과제로 넘어가 반대 방향으로 돌아온다 (계속 반복).
// 띠를 끌거나 번호·‹ ›로 넘기면 2.1초 멈췄다가 그 자리에서 다시 움직인다.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Slide {
	no: number;
	title: string;
	href: string;
	image: ImageMetadata;
	alt: string;
	detections: { name: string; score: number; box: [number, number, number, number] }[];
}
interface Props {
	slides: Slide[];
}
const { slides } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const hasDetections = slides.some((s) => s.detections.length);
---

<div class="hero-detect" data-hero>
	<div class="text">
		<slot />
		{
			hasDetections && (
				<div class="conf" data-conf hidden>
					<div class="conf-head det-label">
						<span>
							confidence <b data-thv>0.50 – 0.70</b>
						</span>
						<span data-count />
					</div>
					<div class="strip">
						<div class="shade" data-shade-l />
						<div class="shade" data-shade-r />
						<div class="win" data-win />
						<input type="range" min="0.6" max="0.9" step="0.01" value="0.6" aria-label="탐지 점수 창 위치" />
					</div>
					<div class="axis det-label">
						<span>0.50</span>
						<span>0.75</span>
						<span>1.00</span>
					</div>
				</div>
			)
		}
	</div>

	<figure class="feature">
		<div class="frame">
			{
				slides.map((s, i) => (
					<div class="slide" data-slide={i} hidden={i > 0} style={`--ar:${s.image.width}/${s.image.height}`}>
						<div class="inner">
							<Image
								src={s.image}
								alt={s.alt}
								widths={[640, 960, 1280]}
								sizes="(max-width: 760px) 100vw, 640px"
								loading={i === 0 ? 'eager' : 'lazy'}
							/>
							{s.detections.map((d) => (
								<div
									class:list={['box', { in: d.box[1] < 6 }]}
									data-s={d.score}
									style={`left:${d.box[0]}%;top:${d.box[1]}%;width:${d.box[2]}%;height:${d.box[3]}%`}
								>
									<span class="det-label">
										{d.name} {d.score.toFixed(2)}
									</span>
								</div>
							))}
						</div>
					</div>
				))
			}
		</div>
		<figcaption>
			<span class="no det-label" data-no>{pad(slides[0].no)}</span>
			<a data-title href={slides[0].href}>{slides[0].title}</a>
			{
				slides.length > 1 && (
					<span class="pager" data-pager hidden>
						<button type="button" data-prev aria-label="이전 과제">
							‹
						</button>
						{slides.map((s, i) => (
							<button type="button" class="num det-label" data-go={i} aria-label={`${pad(s.no)}번 과제`}>
								{pad(s.no)}
							</button>
						))}
						<button type="button" data-next aria-label="다음 과제">
							›
						</button>
					</span>
				)
			}
		</figcaption>
		<script type="application/json" data-meta set:html={JSON.stringify(slides.map((s) => ({ no: pad(s.no), title: s.title, href: s.href })))} />
	</figure>
</div>

<script>
	const W = 0.2; // 점수 창 폭
	const LO = 0.5 + W / 2, // 창 가운데가 오가는 범위
		HI = 1 - W / 2;
	const SWEEP = 6000; // 한쪽 끝에서 다른 쪽 끝까지 걸리는 시간
	const HOLD = 1400; // 끝에 닿은 뒤 멈춤
	const RESUME = 2100; // 사람이 조작한 뒤 멈춤
	const FADE = 250; // 과제를 넘길 때 사진이 사라졌다 나타나는 시간

	for (const root of document.querySelectorAll<HTMLElement>('[data-hero]')) {
		const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
		const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
		const meta: { no: string; title: string; href: string }[] = JSON.parse($('[data-meta]').textContent!);
		const frame = $('.frame');
		const conf = root.querySelector<HTMLElement>('[data-conf]');
		const pager = root.querySelector<HTMLElement>('[data-pager]');
		const pct = (v: number) => ((v - 0.5) / 0.5) * 100;
		const boxes = () => [...slides[cur].querySelectorAll<HTMLElement>('.box')];

		let cur = 0;
		let c = LO; // 창 가운데
		let dir = 1;
		let waitUntil = 0; // 이 시각까지 멈춤
		let advance = false; // 멈춤이 끝나면 다음 과제로
		let dragging = false;
		const wait = (ms: number) => (waitUntil = performance.now() + ms);

		function show(i: number) {
			cur = (i + slides.length) % slides.length;
			slides.forEach((s, k) => (s.hidden = k !== cur));
			$('[data-no]').textContent = meta[cur].no;
			const a = $<HTMLAnchorElement>('[data-title]');
			a.textContent = meta[cur].title;
			a.href = meta[cur].href;
			root.querySelectorAll('[data-go]').forEach((b, k) => b.setAttribute('aria-current', String(k === cur)));
			if (conf) drawBars();
			render();
		}

		// 사람이 넘길 때: 바로 바꾸고 잠깐 멈춤
		function goTo(i: number) {
			advance = false;
			show(i);
			wait(RESUME);
		}

		// 저절로 넘길 때: 사진을 흐렸다가 바꾼다
		function fadeTo(i: number) {
			frame.classList.add('swap');
			wait(FADE * 2);
			setTimeout(() => {
				show(i);
				frame.classList.remove('swap');
			}, FADE);
		}

		function step(dt: number) {
			c = Math.min(HI, Math.max(LO, c + (dir * (HI - LO) * dt) / SWEEP));
			render();
			if ((dir > 0 && c >= HI) || (dir < 0 && c <= LO)) {
				dir = -dir;
				advance = slides.length > 1;
				wait(HOLD);
			}
		}

		let last = 0;
		function tick(t: number) {
			const dt = Math.min(50, last ? t - last : 0); // 탭을 다시 열었을 때 한 번에 튀지 않게
			last = t;
			if (!dragging && t >= waitUntil) {
				if (advance) {
					advance = false;
					fadeTo(cur + 1);
				} else step(dt);
			}
			requestAnimationFrame(tick);
		}

		// ── 점수 띠 ──
		const strip = conf?.querySelector<HTMLElement>('.strip');
		const input = conf?.querySelector<HTMLInputElement>('input');

		function drawBars() {
			strip!.querySelectorAll('.bar').forEach((b) => b.remove());
			for (const box of boxes()) {
				const s = Number(box.dataset.s);
				const bar = document.createElement('i');
				bar.className = 'bar';
				bar.dataset.s = String(s);
				bar.style.left = pct(s) + '%';
				bar.style.height = 30 + s * 60 + '%';
				strip!.prepend(bar);
			}
		}

		function render() {
			if (!conf) return;
			const lo = c - W / 2,
				hi = c + W / 2;
			const inside = (el: HTMLElement) => Number(el.dataset.s) >= lo && Number(el.dataset.s) <= hi;
			$('[data-shade-l]').style.width = pct(lo) + '%';
			$('[data-shade-r]').style.left = pct(hi) + '%';
			Object.assign($('[data-win]').style, { left: pct(lo) + '%', width: pct(hi) - pct(lo) + '%' });
			$('[data-thv]').textContent = `${lo.toFixed(2)} – ${hi.toFixed(2)}`;
			const all = boxes();
			all.forEach((b) => b.classList.toggle('off', !inside(b)));
			strip!.querySelectorAll<HTMLElement>('.bar').forEach((b) => b.classList.toggle('on', inside(b)));
			$('[data-count]').textContent = `${all.filter(inside).length} / ${all.length} detected`;
			input!.value = String(c);
		}

		if (conf && input) {
			conf.hidden = false;
			input.addEventListener('pointerdown', () => (dragging = true));
			const release = () => {
				if (!dragging) return;
				dragging = false;
				wait(RESUME);
			};
			addEventListener('pointerup', release);
			addEventListener('pointercancel', release);
			input.addEventListener('input', () => {
				c = Number(input.value);
				advance = false;
				render();
				wait(RESUME);
			});
		}
		if (pager) {
			pager.hidden = false;
			pager.addEventListener('click', (e) => {
				const b = (e.target as Element).closest<HTMLElement>('button');
				if (!b) return;
				if (b.matches('[data-prev]')) goTo(cur - 1);
				else if (b.matches('[data-next]')) goTo(cur + 1);
				else goTo(Number(b.dataset.go));
			});
		}

		show(0);
		if (conf) requestAnimationFrame(tick);
	}
</script>

<style>
	.hero-detect {
		display: grid;
		grid-template-columns: 5fr 7fr;
		gap: 48px;
		align-items: end;
	}
	.feature {
		margin: 0;
	}
	/* 높이는 늘 4:3. 사진은 원래 비율 그대로 가운데 두고, 박스 층은 사진과 정확히 같은 크기 */
	.frame {
		aspect-ratio: 4 / 3;
		background: var(--card);
		container-type: size;
		transition: opacity 0.25s;
	}
	.frame:global(.swap) {
		opacity: 0;
	}
	.slide {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
	}
	.slide[hidden] {
		display: none;
	}
	.inner {
		position: relative;
		width: min(100cqw, calc(100cqh * var(--ar)));
		aspect-ratio: var(--ar);
	}
	.inner :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 0;
	}
	.box {
		position: absolute;
		border: 1.5px solid var(--detect);
		pointer-events: none;
		transition:
			opacity 0.25s,
			transform 0.25s;
	}
	.box:global(.off) {
		opacity: 0;
		transform: scale(0.96);
	}
	.box span {
		position: absolute;
		left: -1.5px;
		bottom: 100%;
		padding: 4px 6px;
		background: var(--detect);
		color: #fff;
		white-space: nowrap;
	}
	/* 사진 맨 위에 붙은 박스는 라벨이 사진 밖으로 나가지 않게 안쪽에 */
	.box.in span {
		top: -1.5px;
		bottom: auto;
	}

	figcaption {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 12px;
		align-items: start;
		margin-top: 12px;
		font-size: 15px;
	}
	.no {
		color: var(--detect); /* 번호는 탐지 초록 (목업) */
		padding-top: 3px;
	}
	/* 제목 길이가 달라도 높이가 그대로이게: 두 줄 자리를 늘 차지하고, 넘치면 말줄임 */
	figcaption a {
		min-height: 2.9em;
		color: var(--text);
		font-weight: 500;
		line-height: 1.45;
		text-decoration: none;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	figcaption a:hover {
		text-decoration: underline;
	}
	.pager {
		display: flex;
		align-items: center;
		gap: 2px;
		margin-top: -6px;
	}
	.pager button {
		padding: 8px 6px;
		border: 0;
		background: none;
		color: var(--text-muted);
		font-size: 13px;
		line-height: 1;
		cursor: pointer;
	}
	.pager button:hover,
	.pager button[aria-current='true'] {
		color: var(--text);
	}
	.pager .num[aria-current='true'] {
		box-shadow: inset 0 -2px var(--focus);
	}

	.conf {
		max-width: 360px;
		margin-top: 36px;
	}
	.conf-head {
		display: flex;
		justify-content: space-between;
		margin-bottom: 8px;
		color: var(--text-muted);
	}
	.conf-head b,
	.conf-head [data-count] {
		color: var(--text);
		font-weight: 500;
	}
	.conf-head b {
		color: var(--focus);
	}
	.strip {
		position: relative;
		height: 56px;
		border: 1px solid var(--border);
		background: var(--card);
	}
	.strip:has(input:focus-visible) {
		outline: 2px solid var(--focus);
		outline-offset: 3px;
	}
	.strip :global(.bar) {
		position: absolute;
		bottom: 0;
		width: 10px;
		margin-left: -5px;
		background: var(--border);
		transition: background 0.2s;
	}
	.strip :global(.bar.on) {
		background: var(--detect);
	}
	.win {
		position: absolute;
		top: -6px;
		bottom: -6px;
		border-inline: 2px solid var(--focus);
		pointer-events: none;
	}
	.shade {
		position: absolute;
		top: 0;
		bottom: 0;
		background: repeating-linear-gradient(135deg, transparent 0 5px, rgb(127 127 127 / 0.12) 5px 7px);
		pointer-events: none;
	}
	[data-shade-l] {
		left: 0;
	}
	[data-shade-r] {
		right: 0;
	}
	.strip input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		cursor: ew-resize;
	}
	.axis {
		display: flex;
		justify-content: space-between;
		margin-top: 4px;
		color: var(--text-muted);
		font-size: 11px;
	}

	@media (max-width: 760px) {
		.hero-detect {
			grid-template-columns: 1fr;
			gap: 28px;
		}
		.feature {
			order: -1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.box,
		.frame {
			transition: none;
		}
	}
</style>
