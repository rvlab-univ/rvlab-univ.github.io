---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { attachment } from '../lib/attachments';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'news'>;
}

const { post } = Astro.props;
const image = attachment(post.data.image);
---

<a class="news-card card" href={`/news/${post.id}/`}>
	{image && <Image class="thumb" src={image} alt="" width={640} height={360} fit="cover" />}
	<div class="meta">
		<span class="badge">{post.data.category}</span>
		<span class="muted"><FormattedDate date={post.data.pubDate} /></span>
	</div>
	<h3>{post.data.title}</h3>
	<p class="muted">{post.data.description}</p>
</a>

<style>
	.news-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		color: var(--text);
		text-decoration: none;
		transition:
			transform 0.15s,
			border-color 0.15s;
	}
	.news-card:hover {
		transform: translateY(-2px);
		border-color: var(--accent);
		color: var(--text);
	}
	.thumb {
		width: calc(100% + 3rem);
		max-width: none;
		height: auto;
		aspect-ratio: 16 / 9;
		margin: -1.5rem -1.5rem 1rem;
		object-fit: cover;
		border-radius: var(--radius) var(--radius) 0 0;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.6rem;
		font-size: 0.85rem;
	}
	h3 {
		font-size: 1.1rem;
	}
	p {
		margin: 0;
		font-size: 0.93rem;
	}
</style>
