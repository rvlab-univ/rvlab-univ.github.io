---
import { Image } from 'astro:assets';
import { LAB } from '../consts';
import { attachment } from '../lib/attachments';
import HeaderLink from './HeaderLink.astro';

// 로고: src/content/attachments/logo.png (파일을 바꾸면 로고가 바뀜)
const logo = attachment('logo.png');
---

<header>
	<nav>
		<a class="brand" href="/">
			{
				logo ? (
					<Image class="logo" src={logo} width={72} height={72} alt="" />
				) : (
					<span class="logo" aria-hidden="true">
						RV
					</span>
				)
			}
			<span class="brand-text">
				<strong>{LAB.name}</strong>
				<small>{LAB.fullName}</small>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">홈</HeaderLink>
			<HeaderLink href="/research">연구</HeaderLink>
			<HeaderLink href="/members">구성원</HeaderLink>
			<HeaderLink href="/publications">논문</HeaderLink>
			<HeaderLink href="/projects">프로젝트</HeaderLink>
			<HeaderLink href="/news">소식</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0 1rem;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: var(--max-width);
		margin: 0 auto;
		min-height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--text);
		text-decoration: none;
	}
	.logo {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		object-fit: cover;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		font-size: 0.9rem;
	}
	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}
	.brand-text small {
		color: var(--text-muted);
		font-size: 0.75rem;
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding-top: 0.5rem;
		}
		.internal-links {
			overflow-x: auto;
			margin: 0 -1rem;
			padding: 0 0.5rem;
		}
	}
</style>
