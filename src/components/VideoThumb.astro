---
// 썸네일만 먼저 보여주고, 클릭하면 그 자리에서 재생한다 (YouTubePlayer.astro)
// poster를 주면 YouTube 썸네일 대신 그 사진을 쓴다 (논문 제목 슬라이드 대신 실제 장면을 보이려고)
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	id: string;
	title: string;
	poster?: ImageMetadata;
}

const { id, title, poster } = Astro.props;
---

<a class="video" data-yt={id} href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener">
	{
		poster ? (
			<Image src={poster} alt={`${title} 영상`} widths={[480, 960]} sizes="(max-width: 760px) 100vw, 640px" loading="lazy" />
		) : (
			<img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt={`${title} 영상`} loading="lazy" />
		)
	}
	<span class="play" aria-hidden="true">▶</span>
</a>

<style>
	.video {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #000;
	}
	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition:
			transform 0.3s,
			opacity 0.3s;
	}
	.video:hover img {
		opacity: 0.85;
	}
	.play {
		position: absolute;
		inset: 50% auto auto 50%;
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		margin: -26px 0 0 -26px;
		background: rgb(17 18 20 / 0.75);
		color: #fff;
		font-size: 1.1rem;
		padding-left: 3px;
	}
</style>
