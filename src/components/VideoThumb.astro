---
// 썸네일만 먼저 보여주고, 클릭하면 그 자리에서 재생한다 (YouTubePlayer.astro)
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<a class="video" data-yt={id} href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener">
	<img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt={`${title} 영상`} loading="lazy" />
	<span class="play" aria-hidden="true">▶</span>
</a>

<style>
	.video {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 10px;
		background: #000;
	}
	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition:
			transform 0.3s,
			opacity 0.3s;
	}
	.video:hover img {
		transform: scale(1.03);
		opacity: 0.85;
	}
	.play {
		position: absolute;
		inset: 50% auto auto 50%;
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		margin: -26px 0 0 -26px;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.6);
		color: #fff;
		font-size: 1.1rem;
		padding-left: 3px;
	}
</style>
