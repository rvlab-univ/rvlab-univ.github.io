---
import { LAB } from '../consts';

const today = new Date();
---

<footer>
	<div class="inner">
		<div>
			<strong>{LAB.name} · {LAB.fullName}</strong>
			<p class="muted">{LAB.university}</p>
		</div>
		<div>
			<p class="muted">
				<a href={`mailto:${LAB.email}`}>{LAB.email}</a> ·
				<a href={LAB.youtube} target="_blank" rel="noopener">YouTube</a>
			</p>
		</div>
	</div>
	<p class="copy">&copy; {today.getFullYear()} {LAB.name}. All rights reserved.</p>
</footer>
<style>
	footer {
		padding: 2.5rem 1rem 3rem;
		border-top: 1px solid var(--border);
		background: var(--bg-alt);
		font-size: 0.9rem;
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem 2rem;
		max-width: var(--max-width);
		margin: 0 auto;
	}
	.inner p {
		margin: 0.25rem 0 0;
	}
	.copy {
		max-width: var(--max-width);
		margin: 1.5rem auto 0;
		color: var(--text-muted);
		font-size: 0.8rem;
	}
</style>
