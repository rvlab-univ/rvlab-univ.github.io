---
import { Image } from 'astro:assets';
import { memberPhoto } from '../lib/attachments';

interface Props {
	name: string;
	// 표시 너비 (px). 높이는 3:4 증명사진 비율로 정해진다
	width?: number;
}

const { name, width = 72 } = Astro.props;
const height = Math.round((width * 4) / 3);
const photo = memberPhoto(name);
---

<div class="avatar" style={`--w: ${width}px; --h: ${height}px`}>
	{
		photo ? (
			<Image src={photo} alt={`${name} 사진`} width={width * 2} height={height * 2} fit="cover" />
		) : (
			<span aria-hidden="true">{name.slice(0, 1)}</span>
		)
	}
</div>

<style>
	.avatar {
		flex: none;
		display: grid;
		place-items: center;
		width: var(--w);
		height: var(--h);
		overflow: hidden;
		border-radius: 8px;
		background: var(--accent-soft);
		color: var(--accent);
		font-size: calc(var(--w) * 0.4);
		font-weight: 700;
	}
	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		border-radius: 0;
	}
</style>
